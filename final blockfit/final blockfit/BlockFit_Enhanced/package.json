{
  "name": "blockfit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "npm run dev --prefix web",
    "dev:api": "npm run dev --prefix backend",
    "benchmark:test": "node benchmark/evaluate.test.mjs",
